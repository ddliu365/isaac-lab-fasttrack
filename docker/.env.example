# Copy to docker/.env and edit.
ISAACLAB_VERSION=2.3.2
ISAACSIM_VERSION=5.1.0
# Host dirs for persistent caches. First run downloads extensions + shaders (10-30 min); caches make run #2 fast.
CACHE_ROOT=${HOME}/.isaac-fasttrack
# Your workspace, mounted at /workspace inside the container.
WORKSPACE=${HOME}/isaac-workspace
# Set to 1 only if you have a local asset pack (see docs/china_mirror.md).
LOCAL_ASSETS=0
LOCAL_ASSETS_PATH=${HOME}/isaac-assets
# Livestream (WebRTC) for headless boxes. 0 = off.
LIVESTREAM=0
