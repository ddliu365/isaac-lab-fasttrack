#!/usr/bin/env bash
# VRAM/throughput bench inside the container. Writes CSV: task,num_envs,result,peak_vram_mib,steps_per_s,wall_s
# usage: ft-bench <out.csv> [iterations]   (tasks/env counts below; a run that OOMs or crashes is recorded as such)
set -uo pipefail
OUT="${1:?out.csv}"; ITERS="${2:-20}"
TASKS="Isaac-Cartpole-v0 Isaac-Ant-v0 Isaac-Humanoid-v0 Isaac-Velocity-Flat-Anymal-C-v0 Isaac-Velocity-Rough-Anymal-C-v0 Isaac-Velocity-Flat-Unitree-Go2-v0 Isaac-Reach-Franka-v0 Isaac-Open-Drawer-Franka-v0"
ENVS="512 1024 2048 4096"
cd "${ISAACLAB_PATH}"
[ -s "$OUT" ] || echo "task,num_envs,result,peak_vram_mib,steps_per_s,wall_s" > "$OUT"
for t in $TASKS; do
  skip_larger=0
  for n in $ENVS; do
    if [ $skip_larger = 1 ]; then echo "$t,$n,skipped_after_oom,,," >> "$OUT"; continue; fi
    log=/tmp/bench_${t}_${n}.log; peakf=/tmp/peak_${t}_${n}
    ( peak=0; while :; do v=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | head -1); [ "$v" -gt "$peak" ] && peak=$v; echo $peak > $peakf; sleep 1; done ) & mon=$!
    t0=$(date +%s)
    timeout 900 ./isaaclab.sh -p scripts/reinforcement_learning/rsl_rl/train.py --task "$t" --headless --num_envs "$n" --max_iterations "$ITERS" > "$log" 2>&1
    rc=$?; t1=$(date +%s); kill $mon 2>/dev/null; wait $mon 2>/dev/null
    peak=$(cat $peakf 2>/dev/null || echo "")
    sps=$(grep -oE "Computation: [0-9]+ steps/s" "$log" | tail -1 | grep -oE "[0-9]+")
    if grep -qiE "out of memory|CUDA error|cudaErrorMemoryAllocation|PxGpu" "$log"; then res=oom; skip_larger=1
    elif grep -qiE "not registered|No registered env|NameNotFound" "$log"; then res=no_such_task
    elif [ $rc -eq 124 ]; then res=timeout
    elif [ $rc -ne 0 ]; then res="crash_rc$rc"
    else res=ok; fi
    echo "$t,$n,$res,$peak,${sps:-},$((t1-t0))" | tee -a "$OUT"
    pkill -f "train.py --task $t" 2>/dev/null; sleep 3
    [ "$res" = no_such_task ] && break
  done
done
echo "BENCH DONE"
